---
/**
 * Shared layout for all menu pages
 * Provides consistent structure: hero image, intro text, menu grid, CTA.
 * What it says comes from menuView(), driven by the menu's status. While a
 * menu is open, the closed wording is rendered too and DateSwitch shows it
 * after `orderBy`.
 */
import BaseLayout from './BaseLayout.astro';
import MenuGrid from '../components/MenuGrid.astro';
import CTASection from '../components/ui/CTASection.astro';
import DateSwitch from '../components/ui/DateSwitch.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import OrderDeadline from '../components/OrderDeadline.astro';
import { closesOn, menuView } from '../data/season';
import type { Menu } from '../data/types';

interface Props {
  menu: Menu;
}

const { menu } = Astro.props;
const view = menuView(menu);
const closeDate = closesOn(menu);
const closed = menuView(menu, 'closed');
---

<BaseLayout
  title={menu.title}
  description={menu.description}
>
  <section class="menu-page">
    {menu.headerImage && (
      <div class="menu-header">
        <img 
          src={menu.headerImage} 
          alt={menu.title} 
          class="menu-hero-image" 
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
    
    <div class="menu-intro">
      <h1>{menu.title}</h1>
      <p class="subtitle">
        <DateSwitch date={closeDate}>{view.subtitle}<Fragment slot="after">{closed.subtitle}</Fragment></DateSwitch>
      </p>
      {view.countdown && (
        <OrderDeadline
          deadline={view.countdown.date}
          label={view.countdown.label}
          opens={view.countdown.opens}
        />
      )}
      <p class="intro-text">
        <DateSwitch date={closeDate}>{view.intro}<Fragment slot="after">{closed.intro}</Fragment></DateSwitch>
      </p>
    </div>

    <MenuGrid
      items={menu.items}
      menuSlug={menu.slug}
      menuTitle={menu.title}
      orderLink="/order/"
      showPrices={view.showPrices}
      canOrder={view.canOrder}
      allSoldOut={view.allSoldOut}
      closesOn={closeDate}
    />

    <CTASection
      title={view.cta.title}
      subtitle={view.cta.text}
      primaryText="Place Your Order"
      primaryHref="/order/"
      secondaryText="Ask a Question"
      secondaryHref="/contact/"
      variant="sage"
    >
      <DateSwitch slot="title" date={closeDate}>{view.cta.title}<Fragment slot="after">{closed.cta.title}</Fragment></DateSwitch>
      <DateSwitch slot="subtitle" date={closeDate}>{view.cta.text}<Fragment slot="after">{closed.cta.text}</Fragment></DateSwitch>
    </CTASection>
  </section>
  
  <!-- Mobile-only sticky order button -->
  <StickyMobileCTA />
</BaseLayout>

<style>
  .menu-page {
    padding: var(--space-xl) 0 0;
  }
  
  .menu-header {
    max-width: 800px;
    margin: 0 auto var(--space-2xl);
    padding: 0 var(--space-lg);
  }
  
  .menu-hero-image {
    width: 100%;
    border-radius: 16px;
    box-shadow: var(--shadow-medium);
  }
  
  .menu-intro {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-2xl);
    padding: 0 var(--space-lg);
  }
  
  .menu-intro h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--charcoal);
    margin-bottom: var(--space-sm);
  }
  
  .menu-intro .subtitle {
    font-family: var(--font-accent);
    font-size: 1.5rem;
    color: var(--sage);
    margin-bottom: var(--space-md);
    max-width: none;
  }
  
  .menu-intro .intro-text {
    color: var(--warm-gray);
    font-size: 1.1rem;
    max-width: none;
  }
</style>
