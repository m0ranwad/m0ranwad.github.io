---
/**
 * Design sample A, the printed card: the Christmas menu, shown as if orders
 * were open. Phase 0 of the redesign (#2). The menu is typeset as one ruled
 * column; three small photos sit beside it.
 */
import SampleShell from '../../../components/directions/SampleShell.astro';
import InquiryToggle from '../../../components/directions/InquiryToggle.astro';
import Photo from '../../../components/ui/Photo.astro';
import DateSwitch from '../../../components/ui/DateSwitch.astro';
import { menuSample } from '../../../components/directions/copy';
import { christmasMenu as menu } from '../../../data/menus';
import { orderBySentence, samplePhotos } from '../../../components/directions/menu';

const photos = samplePhotos(menu);
---

<SampleShell dir="a" title="Christmas" page="christmas/" note="Christmas is shown as if orders were open.">
  <div class="wrap">
    <header class="intro">
      <h1>Christmas</h1>
      <p>{menuSample.intro}</p>
      <p class="deadline">
        <DateSwitch date={menu.orderBy}>{orderBySentence(menu)}<Fragment slot="after">{menuSample.closed}</Fragment></DateSwitch>
      </p>
    </header>

    <div class="layout">
      <ul class="menu">
        {menu.items.map((item) => (
          <li>
            <div class="line">
              <h2>{item.name}</h2>
              <p class="price">{item.soldOut ? menuSample.soldOut : item.price}</p>
            </div>
            <p class="desc">{item.description}</p>
            {!item.soldOut && (
              <DateSwitch date={menu.orderBy}><InquiryToggle item={item} menuSlug={menu.slug} menuTitle={menu.title} /></DateSwitch>
            )}
          </li>
        ))}
      </ul>

      <div class="photos">
        {photos.map((item, i) => (
          <figure>
            <Photo src={item.image} alt="" sizes="(min-width: 48rem) 15rem, 30vw" widths={[400, 800]} loading={i === 0 ? 'eager' : 'lazy'} />
            <figcaption>{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <p class="after">{menuSample.after} <a href="/order/">Review your inquiry</a></p>
  </div>
</SampleShell>

<style>
  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
  .intro { margin-top: 2.5rem; max-width: var(--measure); }
  .intro > * + * { margin-top: 0.75rem; }
  h1 { font-size: 2.5rem; }
  .deadline { font-style: italic; }

  .layout { display: flex; flex-direction: column; }
  .photos {
    order: -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.625rem;
    margin-top: 2rem;
  }
  figure { margin: 0; }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  figcaption { font-size: 0.875rem; color: var(--muted); margin-top: 0.375rem; line-height: 1.3; }

  .menu {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--ink);
    max-width: 38rem;
  }
  .menu li { padding: 1rem 0 0.5rem; border-bottom: 1px solid var(--rule); }
  .line { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h2 { font-size: 1.3125rem; }
  .price { text-align: right; max-width: 45%; font-variant-numeric: lining-nums; }
  .desc { color: var(--muted); margin-top: 0.25rem; }
  .after { margin-top: 2rem; max-width: var(--measure); }

  @media (min-width: 48rem) {
    .wrap { padding: 0 2rem; }
    .intro { margin-top: 4rem; }
    h1 { font-size: 3.25rem; }
    .layout { flex-direction: row; gap: 5rem; align-items: flex-start; }
    .menu { flex: 1; }
    .photos { order: 0; grid-template-columns: 1fr; width: 15rem; flex: none; gap: 1.5rem; margin-top: 2.5rem; }
  }
</style>
