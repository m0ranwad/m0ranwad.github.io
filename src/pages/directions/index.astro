---
/**
 * Phase 0 of the redesign (#2): links to the two design samples, for the
 * owner to compare on her phone. Deleted in Phase 1.
 */
import { sampleNames } from '../../components/directions/copy';

const samples = (['a', 'b'] as const).map((dir) => ({ dir, name: sampleNames[dir] }));

// "Today's site" links to the current pages, which this preview also serves.
const pages = [
  { title: 'Home page', note: "Today's home page features the Christmas announcement, because that is where the season is now. A and B show the resting state between seasons.", today: '/', path: '' },
  { title: 'Christmas menu', note: "Today's menu shows Christmas as coming soon. A and B show it as if orders were open, so you can see the Add to inquiry control.", today: '/christmas/', path: 'christmas/' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Two design samples | Thymeless Treats Bakery</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <main>
      <h1>Two looks for the new site</h1>
      <p>Each page is shown three ways: how it looks today, then A and B. Open them one after another on your phone to compare. The words are the same in A and B, so only the look differs. Nothing here is on the live site.</p>
      {pages.map(({ title, note, today, path }) => (
        <section>
          <h2>{title}</h2>
          <p class="note">{note}</p>
          <ul>
            <li><a href={today}>Today's site</a></li>
            {samples.map(({ dir, name }) => (
              <li><a href={`/directions/${dir}/${path}`}>{dir.toUpperCase()}, {name}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #faf7f0;
    color: #2b2722;
    font: 1.125rem/1.55 Georgia, serif;
  }
  main { max-width: 34rem; padding: 2rem 1rem; }
  h1 { font-size: 1.75rem; font-weight: normal; margin: 0 0 1rem; }
  h2 { font-size: 1.25rem; font-weight: normal; margin: 2rem 0 0.25rem; }
  .note { font-size: 1rem; margin: 0 0 0.5rem; }
  ul { margin: 0; padding: 0; list-style: none; }
  a { color: #4f6a3e; display: inline-block; padding: 0.5rem 0; }
</style>
