---
/**
 * Order countdown for seasonal menus: "Christmas orders close in 5 days",
 * or with `opens`, "Christmas orders open in 5 days".
 * - Closing: counts to the end of the day, with urgency colours near the end
 * - Opening: counts to the start of the day, always in the calm colour
 * - Recounted in the browser on load and hourly; hides itself once the day arrives
 *
 * Usage:
 *   <OrderDeadline deadline="2025-02-10" label="Valentine's orders" />
 *   <OrderDeadline deadline="2025-12-01" label="Christmas orders" opens />
 */
import { daysUntil, endOfDay, startOfDay } from '../scripts/dates';

interface Props {
  /** Date in ISO format (YYYY-MM-DD) */
  deadline: string;
  /** Label text (e.g., "Valentine's orders") */
  label?: string;
  /** Where to link when clicked */
  href?: string;
  /** Count down to orders opening on this day instead of closing */
  opens?: boolean;
}

const { 
  deadline,
  label = "Orders",
  href = "/order/",
  opens = false,
} = Astro.props;

// Calculate initial days remaining (for SSG)
const target = opens ? startOfDay(deadline) : endOfDay(deadline);
const initialDays = daysUntil(target);
const verb = opens ? 'open' : 'close';

// Determine urgency level for initial render. Rendered even when the build
// thinks the day has arrived: the build runs in UTC, so the viewer's
// calendar may be a day behind. The browser shows or hides it.
const getUrgencyClass = (days: number) => {
  if (opens) return 'normal';
  if (days <= 2) return 'urgent';
  if (days <= 5) return 'soon';
  return 'normal';
};

const urgencyClass = getUrgencyClass(initialDays);
---

<a 
    href={href}
    class={`order-deadline ${urgencyClass}`}
    style={initialDays > 0 ? undefined : 'display: none'}
    data-deadline={deadline}
    data-opens={opens ? '' : undefined}
    id="order-deadline"
  >
    <span class="deadline-icon">⏰</span>
    <span class="deadline-text">
      <strong>{label}</strong> {verb} in <span class="days-count">{initialDays}</span> <span class="days-unit">{initialDays === 1 ? 'day' : 'days'}</span>
    </span>
    <span class="deadline-arrow">→</span>
  </a>

<script>
  import { daysUntil, endOfDay, onDateBoundaries, startOfDay } from '../scripts/dates';

  // Recount in the browser, in the viewer's own time zone, so the page is
  // right without a redeploy
  const deadlineEl = document.getElementById('order-deadline') as HTMLElement | null;
  const deadline = deadlineEl?.dataset.deadline;

  if (deadlineEl && deadline) {
    const opens = 'opens' in deadlineEl.dataset;
    const target = opens ? startOfDay(deadline) : endOfDay(deadline);

    function updateCountdown() {
      const daysLeft = daysUntil(target);
      if (!deadlineEl) return;

      deadlineEl.style.display = daysLeft > 0 ? '' : 'none';
      if (daysLeft <= 0) return;

      const daysEl = deadlineEl.querySelector('.days-count');
      const unitEl = deadlineEl.querySelector('.days-unit');
      if (daysEl) daysEl.textContent = String(daysLeft);
      if (unitEl) unitEl.textContent = daysLeft === 1 ? 'day' : 'days';

      deadlineEl.classList.remove('normal', 'soon', 'urgent', 'expired');
      if (!opens && daysLeft <= 2) {
        deadlineEl.classList.add('urgent');
      } else if (!opens && daysLeft <= 5) {
        deadlineEl.classList.add('soon');
      } else {
        deadlineEl.classList.add('normal');
      }
    }

    // Update now, as each day ticks over (the count changes at midnight
    // before the target too), and when the tab is shown again
    const DAY = 24 * 60 * 60 * 1000;
    const ticks = Array.from({ length: 60 }, (_, i) => new Date(target.getTime() - i * DAY));
    onDateBoundaries(ticks, updateCountdown);
  }
</script>

<style>
  .order-deadline {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: 50px;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    max-width: fit-content;
    margin: 0 auto var(--space-lg);
  }
  
  .order-deadline:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }
  
  .deadline-icon {
    font-size: 1.2rem;
  }
  
  .deadline-text {
    color: inherit;
  }
  
  .deadline-text strong {
    font-weight: 600;
  }
  
  .days-count {
    font-weight: 700;
    font-size: 1.1em;
  }
  
  .deadline-arrow {
    opacity: 0.7;
    transition: transform 0.2s ease;
  }
  
  .order-deadline:hover .deadline-arrow {
    transform: translateX(3px);
  }
  
  /* Normal state - sage green */
  .order-deadline.normal {
    background: var(--sage-light);
    color: var(--sage-dark);
    border: 1px solid var(--sage);
  }
  
  .order-deadline.normal:hover {
    background: var(--sage);
    color: white;
    box-shadow: 0 4px 12px rgba(143, 163, 120, 0.3);
  }
  
  /* Soon state (≤5 days) - warm amber */
  .order-deadline.soon {
    background: #FEF3E2;
    color: #92400E;
    border: 1px solid #F59E0B;
  }
  
  .order-deadline.soon:hover {
    background: #F59E0B;
    color: white;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }
  
  /* Urgent state (≤2 days) - warning red */
  .order-deadline.urgent {
    background: #FEE2E2;
    color: #991B1B;
    border: 1px solid #EF4444;
    animation: pulse-urgent 2s ease-in-out infinite;
  }
  
  .order-deadline.urgent:hover {
    background: #EF4444;
    color: white;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
  }
  
  @keyframes pulse-urgent {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }
  
  /* Expired - hidden */
  .order-deadline.expired {
    display: none;
  }
  
  /* Mobile adjustments */
  @media (max-width: 480px) {
    .order-deadline {
      font-size: 0.85rem;
      padding: var(--space-xs) var(--space-sm);
    }
    
    .deadline-icon {
      font-size: 1rem;
    }
  }
</style>
