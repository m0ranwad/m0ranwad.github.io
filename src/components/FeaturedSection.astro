---
/**
 * The season on the home page: the menu leadMenu() picks, with a countdown,
 * a status label on the photo (unless orders are open) and a button. With no
 * menu, the between-seasons message. The redesign (#2) decides how that
 * state looks; this one reuses the section's styles.
 */
import OrderDeadline from './OrderDeadline.astro';
import DateSwitch from './ui/DateSwitch.astro';
import { closesOn, menuView } from '../data/season';
import type { SeasonalMenu } from '../data/types';

interface Props {
  menu?: SeasonalMenu;
}

const { menu } = Astro.props;
const view = menu && menuView(menu);
const closed = menu && menuView(menu, 'closed');
const closeDate = menu && closesOn(menu);
const menuLink = menu && `/${menu.slug}/`;
const badge = view && !view.canOrder ? view.badge : undefined;
---

{menu && view && closed ? (
  <section class="featured-section">
    <h2>Featured This Season</h2>
    {view.countdown && (
      <OrderDeadline 
        deadline={view.countdown.date} 
        label={view.countdown.label}
        opens={view.countdown.opens}
        href={menuLink}
      />
    )}
    <div class="featured-menu-container">
      <a href={menuLink} class="featured-menu-link">
        <img src={menu.headerImage || '/assets/img/easter/IMG_6388.jpg'} alt={menu.title} loading="eager" />
        {badge && <span class="sold-out-overlay">{badge}</span>}
        {closeDate && (
          <DateSwitch date={closeDate}><Fragment slot="after"><span class="sold-out-overlay">{closed.badge}</span></Fragment></DateSwitch>
        )}
      </a>
      <a href={menuLink} class="btn-primary featured-cta">
        <DateSwitch date={closeDate}>{view.homeButton}<Fragment slot="after">{closed.homeButton}</Fragment></DateSwitch>
      </a>
    </div>
  </section>
) : (
  <section class="featured-section between-seasons">
    <h2>Between Seasons</h2>
    <p>Our next seasonal menu is on its way. Custom cookies, cakes and gifts are available year-round.</p>
    <div class="featured-menu-container">
      <a href="/holidays/" class="btn-primary featured-cta">Browse Our Menus</a>
    </div>
  </section>
)}

<style>
  .featured-section {
    text-align: center;
    padding: var(--space-3xl) var(--space-lg);
    max-width: 900px;
    margin: 0 auto;
  }
  
  .featured-section h2 {
    margin-bottom: var(--space-xl);
  }
  
  .featured-menu-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }
  
  .featured-menu-link {
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-medium);
    transition: all var(--transition-smooth);
    max-width: 100%;
  }
  
  .featured-menu-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-heavy);
  }
  
  .featured-menu-link img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sold-out-overlay {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    background: var(--terracotta, #D4806F);
    color: var(--white);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.4rem 1.2rem;
    border-radius: 8px;
    letter-spacing: 0.02em;
  }
  
  .featured-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--sage) 0%, var(--sage-dark) 100%);
    color: var(--white);
    font-weight: 600;
    font-family: var(--font-body);
    text-decoration: none;
    border-radius: 8px;
    min-height: 44px;
    transition: all var(--transition-smooth);
    font-size: 1.125rem;
    padding: var(--space-lg) var(--space-2xl);
  }

  .featured-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(143, 163, 120, 0.4);
    color: var(--white);
  }
</style>
